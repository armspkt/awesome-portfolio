{
  "name": "awesome-portfolio",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "precommit": "lint-staged",
    "dev": "next",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "export": "NEXT_EXPORT=true next build && NEXT_EXPORT=true next export",
    "deploy": "yarn export && firebase deploy",
    "analyze": "BUNDLE_ANALYZE=both next build",
    "analyze:server": "BUNDLE_ANALYZE=server next build",
    "analyze:browser": "BUNDLE_ANALYZE=browser next build"
  },
  "lint-staged": {
    "src/**/*.{js,json}": [
      "prettier --write",
      "git add"
    ],
    "{package.json,.prettierrc}": [
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@marsidev/react-turnstile": "^1.3.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "framer-motion": "^12.23.12",
    "lax.js": "^2.0.3",
    "minimatch": "^10.0.3",
    "next": "^15.4.6",
    "next-pwa": "^5.6.0",
    "next-seo": "^6.8.0",
    "next-sitemap": "^4.2.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-intersection-observer": "^9.16.0",
    "react-overdrive": "^0.0.10",
    "react-plx": "^2.1.2",
    "react-progressive-image": "^0.6.0",
    "react-query": "^3.39.3",
    "styled-components": "^6.1.19",
    "styled-media-query": "^2.1.2",
    "typed.js": "^2.1.0",
    "vconsole": "^3.15.1"
  },
  "devDependencies": {
    "@types/material-ui": "^0.21.18",
    "@types/minimatch": "^6.0.0",
    "@types/next": "^9.0.0",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/styled-components": "^5.1.34",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.x"
  }
}
